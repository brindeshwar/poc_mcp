GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
GEMINI_THINKING_EXTRACT=low
GEMINI_THINKING_ANSWER=minimal
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# hybrid (vector + full-text) or vector
SEARCH_MODE=hybrid

# mongo (Atlas) or memory (no database; data lost on restart)
STORE_BACKEND=mongo
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB=listenloom
MEETINGS_COLLECTION=meeting_records
CHUNKS_COLLECTION=meeting_chunks
VECTOR_INDEX_NAME=meeting_chunks_vector_index
TEXT_INDEX_NAME=meeting_chunks_text_index

MCP_HOST=127.0.0.1
MCP_PORT=8001
# Endpoint auth: set at least one before exposing the hub beyond localhost.
#   MCP_AUTH_TOKEN: our own clients (Slack bot, Streamlit, seed script) send it as a Bearer token.
#   SLACK_SIGNING_SECRET: lets Slackbot's MCP client in (Slack identity auth, signed requests).
MCP_AUTH_TOKEN=
SLACK_SIGNING_SECRET=
# Public hostnames for the hub, comma-separated (e.g. your ngrok domain for Slackbot).
MCP_ALLOWED_HOSTS=
# Used by the Streamlit UI and seed script (they also read MCP_AUTH_TOKEN)
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Jira Task Service (poc_jira). Empty disables the create_jira_tasks tool.
JIRA_SERVICE_URL=http://127.0.0.1:8000
JIRA_SERVICE_API_KEY=
